{
  "name": "@ondewo/ondewo-sip-client-js",
  "version": "5.4.1",
  "description": "ONDEWO Session Initiation Protocol (SIP) Client library for Js",
  "author": "ONDEWO GmbH",
  "homepage": "https://ondewo.com",
  "license": "Apache-2.0",
  "keywords": [
    "ondewo",
    "sip",
    "api",
    "client",
    "js",
    "grpc"
  ],
  "scripts": {
    "test": "npm run test:auth && npm run test:examples",
    "initialize": "git submodule update --init --recursive --remote",
    "build": "docker run -v ${PWD}:/input-volume -v ${PWD}/../api:/output-volume ondewo-js-proto-compiler ondewo-sip-api ondewo-sip-api ondewo",
    "debug": "docker run --entrypoint /bin/bash -v ${PWD}/src:/input-volume -v ${PWD}/src/..:/output-volume $npm_package_config_compiler",
    "publish-npm": "npm publish ../npm --access public",
    "build-update": "npm run build-only && npm run start-example",
    "start-example": "sudo cp lib/sip.js example/lib/sip.js && http-server example",
    "example-link-lib": "sudo ln -s lib/sip.js example/lib/sip.js",
    "build-sample": "docker run -v ${PWD}/src:/input-volume -v ${PWD}/src/../api:/output-volume $npm_package_config_compiler sip ondewo-sip-api ondewo-sip-api ondewo",
    "test:auth": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --include auth/offlineTokenProvider.js --exclude '**/*.spec.js' --reporter text node --test auth/offlineTokenProvider.spec.js",
    "test:examples": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --include examples/sipStatusExample.js --exclude '**/*.spec.js' --reporter text node --test examples/sipStatusExample.spec.js"
  },
  "repository": {
    "type": "git",
    "directory": "https://github.com/ondewo/ondewo-sip-client-js.git"
  },
  "dependencies": {
    "google-protobuf": "^3.21.4",
    "grpc-web": "^1.5.0",
    "terser-webpack-plugin": "^5.3.14",
    "undici": "^6.27.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "c8": "^11.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "global": "^4.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
